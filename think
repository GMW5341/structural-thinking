#!/usr/bin/env python3
"""사고 모음집 (Thinking Collection) - 구조적 유추 기반 메모 관리 CLI

사용법:
  think add "내용" --source reading --domain medical --structure bottleneck
  think list
  think list --tag domain/medical
  think spark                    # 랜덤 메모 2개로 구조적 유추
  think spark --mode structural  # 같은 구조, 다른 도메인끼리
  think structures               # 사용 가능한 구조 패턴 목록
  think search "키워드"
  think tags
  think show 3
  think evolve 3                 # 단계 승격

메모는 ./notes/ 폴더에 Obsidian 호환 마크다운으로 저장됩니다.
"""

import argparse
import os
import sys
import json
from datetime import datetime
from pathlib import Path

NOTES_DIR = Path(__file__).parent / "notes"
INDEX_FILE = NOTES_DIR / ".index.json"

VALID_SOURCES = ["reading", "conversation", "observation", "experience"]
VALID_DOMAINS = ["medical", "business", "tech", "life"]
VALID_STAGES = ["raw", "pattern", "hypothesis", "validated"]
VALID_FRAMEWORKS = ["first-principles", "analogy", "inversion", "constraint"]

# 사고의 구조 패턴 - 내용(what)이 아닌 형태(how)를 포착
STRUCTURE_PATTERNS = {
    "bottleneck":      "보이는 문제 ≠ 진짜 병목",
    "transfer":        "A의 변화 → B에도 적용 가능",
    "inversion":       "반대로 하면 오히려 나음",
    "emergence":       "단순 요소들의 조합 → 예측 못한 결과",
    "threshold":       "양적 축적 → 질적 전환 (임계점)",
    "feedback-loop":   "A→B→A 순환 (강화 or 약화)",
    "constraint-flip": "제약이 오히려 장점이 됨",
    "mismatch":        "공급과 수요의 불일치",
    "hidden-cost":     "보이는 비용 뒤에 숨은 비용",
    "proxy-failure":   "측정 지표 ≠ 실제 목표",
}


def load_index():
    if INDEX_FILE.exists():
        return json.loads(INDEX_FILE.read_text())
    return {"next_id": 1, "notes": []}


def save_index(index):
    NOTES_DIR.mkdir(parents=True, exist_ok=True)
    INDEX_FILE.write_text(json.dumps(index, ensure_ascii=False, indent=2))


def make_filename(note_id, title_hint):
    safe = "".join(c if c.isalnum() or c in "가-힣ㄱ-ㅎㅏ-ㅣ -_" else "_" for c in title_hint[:30])
    safe = safe.strip("_ ")
    if not safe:
        safe = "note"
    return f"{note_id:04d}-{safe}.md"


def build_frontmatter(tags, created, structure=None):
    lines = ["---"]
    lines.append(f"created: {created}")
    lines.append(f"tags: [{', '.join(tags)}]")
    if structure:
        lines.append(f"structure: {structure}")
    lines.append("---")
    return "\n".join(lines)


def cmd_add(args):
    NOTES_DIR.mkdir(parents=True, exist_ok=True)

    index = load_index()
    note_id = index["next_id"]

    tags = []
    if args.source:
        tags.append(f"source/{args.source}")
    if args.domain:
        tags.append(f"domain/{args.domain}")
    if args.stage:
        tags.append(f"stage/{args.stage}")
    else:
        tags.append("stage/raw")
    if args.framework:
        tags.append(f"framework/{args.framework}")

    now = datetime.now().strftime("%Y-%m-%d %H:%M")
    content_text = args.content
    structure = getattr(args, "structure", None)

    filename = make_filename(note_id, content_text)
    frontmatter = build_frontmatter(tags, now, structure)

    filepath = NOTES_DIR / filename
    filepath.write_text(f"{frontmatter}\n\n{content_text}\n", encoding="utf-8")

    index["notes"].append({
        "id": note_id,
        "file": filename,
        "tags": tags,
        "structure": structure,
        "created": now,
        "preview": content_text[:80],
    })
    index["next_id"] = note_id + 1
    save_index(index)

    print(f"✓ #{note_id} 저장 → notes/{filename}")
    print(f"  태그: {' '.join(tags)}")
    if structure:
        print(f"  구조: {structure} — {STRUCTURE_PATTERNS.get(structure, '')}")


def cmd_list(args):
    index = load_index()
    notes = index["notes"]

    if args.tag:
        notes = [n for n in notes if any(args.tag in t for t in n["tags"])]
    if args.stage:
        notes = [n for n in notes if f"stage/{args.stage}" in n["tags"]]
    if args.source:
        notes = [n for n in notes if f"source/{args.source}" in n["tags"]]
    if args.domain:
        notes = [n for n in notes if f"domain/{args.domain}" in n["tags"]]

    if not notes:
        print("(메모 없음)")
        return

    for n in notes:
        tags_str = " ".join(f"[{t}]" for t in n["tags"])
        print(f"  #{n['id']:>3}  {n['created']}  {tags_str}")
        print(f"       {n['preview']}")
        print()


def cmd_search(args):
    index = load_index()
    keyword = args.keyword.lower()
    found = 0

    for n in index["notes"]:
        filepath = NOTES_DIR / n["file"]
        if not filepath.exists():
            continue
        content = filepath.read_text(encoding="utf-8").lower()
        if keyword in content:
            tags_str = " ".join(f"[{t}]" for t in n["tags"])
            print(f"  #{n['id']:>3}  {n['created']}  {tags_str}")
            print(f"       {n['preview']}")
            print()
            found += 1

    if found == 0:
        print(f"'{args.keyword}' 검색 결과 없음")
    else:
        print(f"--- {found}개 발견")


def cmd_show(args):
    index = load_index()
    note = next((n for n in index["notes"] if n["id"] == args.id), None)
    if not note:
        print(f"#{args.id} 메모를 찾을 수 없습니다")
        return

    filepath = NOTES_DIR / note["file"]
    if not filepath.exists():
        print(f"파일 없음: {note['file']}")
        return

    print(filepath.read_text(encoding="utf-8"))


def cmd_tags(args):
    index = load_index()
    tag_counts = {}
    for n in index["notes"]:
        for t in n["tags"]:
            tag_counts[t] = tag_counts.get(t, 0) + 1

    if not tag_counts:
        print("(태그 없음)")
        return

    for tag in sorted(tag_counts.keys()):
        print(f"  {tag:<30} ({tag_counts[tag]})")


def cmd_structures(args):
    """사용 가능한 구조 패턴 목록"""
    print("  사고 구조 패턴 (--structure 옵션에 사용):\n")
    for key, desc in STRUCTURE_PATTERNS.items():
        print(f"    {key:<20} {desc}")
    print()

    # 현재 메모에서 구조별 통계
    index = load_index()
    struct_counts = {}
    for n in index["notes"]:
        s = n.get("structure")
        if s:
            struct_counts[s] = struct_counts.get(s, 0) + 1

    if struct_counts:
        print("  내 메모 구조 분포:")
        for s in sorted(struct_counts.keys()):
            bar = "█" * struct_counts[s]
            print(f"    {s:<20} {bar} ({struct_counts[s]})")


def cmd_spark(args):
    """랜덤 메모 2개를 뽑아 구조적 유추를 시도한다.

    핵심: 내용(키워드)이 아닌 구조(패턴)로 연결한다.
    외분점 — 두 메모 안에 없는 새로운 관점을 제시한다.
    """
    import random

    index = load_index()
    notes = index["notes"]

    if len(notes) < 2:
        print("메모가 2개 이상 있어야 spark를 사용할 수 있습니다.")
        return

    # 구조가 같은 메모끼리 연결 (같은 패턴, 다른 도메인)
    # 또는 완전 랜덤으로 뽑아 강제 연결
    mode = getattr(args, "mode", "random")

    if mode == "structural":
        # 같은 구조, 다른 도메인의 메모 찾기
        structured = [n for n in notes if n.get("structure")]
        pairs = []
        for i, a in enumerate(structured):
            for b in structured[i+1:]:
                if a.get("structure") == b.get("structure"):
                    a_domains = [t for t in a["tags"] if t.startswith("domain/")]
                    b_domains = [t for t in b["tags"] if t.startswith("domain/")]
                    if a_domains != b_domains:
                        pairs.append((a, b))
        if pairs:
            a, b = random.choice(pairs)
        elif len(structured) >= 2:
            a, b = random.sample(structured, 2)
        else:
            a, b = random.sample(notes, 2)
    else:
        a, b = random.sample(notes, 2)

    # 출력
    print("=" * 60)
    print("  SPARK — 구조적 유추 시도")
    print("=" * 60)
    print()

    a_struct = a.get("structure", "?")
    b_struct = b.get("structure", "?")
    a_struct_desc = STRUCTURE_PATTERNS.get(a_struct, "미지정")
    b_struct_desc = STRUCTURE_PATTERNS.get(b_struct, "미지정")

    print(f"  ◆ 메모 A (#{a['id']})")
    print(f"    {a['preview']}")
    print(f"    구조: {a_struct} — {a_struct_desc}")
    tags_a = " ".join(f"[{t}]" for t in a["tags"])
    print(f"    {tags_a}")
    print()
    print(f"  ◆ 메모 B (#{b['id']})")
    print(f"    {b['preview']}")
    print(f"    구조: {b_struct} — {b_struct_desc}")
    tags_b = " ".join(f"[{t}]" for t in b["tags"])
    print(f"    {tags_b}")
    print()
    print("─" * 60)

    # 구조가 같으면 → 도메인 간 전이 질문
    # 구조가 다르면 → 강제 외분점 질문
    if a_struct == b_struct and a_struct != "?":
        print(f"  같은 구조: [{a_struct}] — {a_struct_desc}")
        print()
        print("  ▶ 질문: A에서 작동하는 원리가 B의 맥락에서도 성립할까?")
        print("  ▶ 질문: 이 구조가 깨지는 조건은 뭘까?")
        print("  ▶ 질문: 이 구조를 알고 있는 제3의 영역은?")
    else:
        print("  다른 구조 — 강제 외분점 탐색")
        print()
        print("  ▶ 질문: A의 구조를 B에 적용하면 어떤 해석이 나올까?")
        print(f"          (B를 '{a_struct_desc}'의 관점으로 보면?)")
        print("  ▶ 질문: B의 구조를 A에 적용하면?")
        print(f"          (A를 '{b_struct_desc}'의 관점으로 보면?)")
        print("  ▶ 질문: A도 B도 아닌, 이 둘을 동시에 설명하는")
        print("          더 상위의 구조가 있을까?")

    print()
    print("─" * 60)
    print("  이 spark에서 떠오른 생각이 있다면:")
    print(f"  ./think add \"내용\" --source observation --stage pattern")
    print()


def cmd_evolve(args):
    """메모의 단계를 승격시킨다 (raw → pattern → hypothesis → validated)"""
    index = load_index()
    note = next((n for n in index["notes"] if n["id"] == args.id), None)
    if not note:
        print(f"#{args.id} 메모를 찾을 수 없습니다")
        return

    stage_order = VALID_STAGES
    current = None
    for t in note["tags"]:
        if t.startswith("stage/"):
            current = t.split("/")[1]
            break

    if not current:
        current = "raw"

    if args.to:
        new_stage = args.to
    else:
        idx = stage_order.index(current)
        if idx >= len(stage_order) - 1:
            print(f"#{args.id}는 이미 최종 단계 ({current})입니다")
            return
        new_stage = stage_order[idx + 1]

    # 인덱스 업데이트
    note["tags"] = [t for t in note["tags"] if not t.startswith("stage/")]
    note["tags"].append(f"stage/{new_stage}")

    # 파일 업데이트
    filepath = NOTES_DIR / note["file"]
    if filepath.exists():
        content = filepath.read_text(encoding="utf-8")
        content = content.replace(f"stage/{current}", f"stage/{new_stage}")
        filepath.write_text(content, encoding="utf-8")

    save_index(index)
    print(f"✓ #{args.id}: stage/{current} → stage/{new_stage}")


def main():
    parser = argparse.ArgumentParser(
        description="사고 모음집 - 태깅 기반 메모 관리",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command")

    # add
    p_add = sub.add_parser("add", help="새 메모 추가")
    p_add.add_argument("content", help="메모 내용")
    p_add.add_argument("--source", "-s", choices=VALID_SOURCES)
    p_add.add_argument("--domain", "-d", choices=VALID_DOMAINS)
    p_add.add_argument("--stage", choices=VALID_STAGES, default=None)
    p_add.add_argument("--framework", "-f", choices=VALID_FRAMEWORKS)
    p_add.add_argument("--structure", choices=list(STRUCTURE_PATTERNS.keys()),
                       help="사고의 구조 패턴")

    # list
    p_list = sub.add_parser("list", aliases=["ls"], help="메모 목록")
    p_list.add_argument("--tag", "-t", help="태그 필터")
    p_list.add_argument("--stage", choices=VALID_STAGES)
    p_list.add_argument("--source", choices=VALID_SOURCES)
    p_list.add_argument("--domain", choices=VALID_DOMAINS)

    # search
    p_search = sub.add_parser("search", help="키워드 검색")
    p_search.add_argument("keyword", help="검색어")

    # show
    p_show = sub.add_parser("show", help="메모 상세 보기")
    p_show.add_argument("id", type=int, help="메모 번호")

    # tags
    sub.add_parser("tags", help="태그 통계")

    # evolve
    p_evolve = sub.add_parser("evolve", help="메모 단계 승격")
    p_evolve.add_argument("id", type=int, help="메모 번호")
    p_evolve.add_argument("--to", choices=VALID_STAGES, help="목표 단계")

    # spark
    p_spark = sub.add_parser("spark", help="랜덤 메모 2개로 구조적 유추 시도")
    p_spark.add_argument("--mode", "-m", choices=["random", "structural"],
                         default="random",
                         help="random: 완전 랜덤, structural: 같은 구조 다른 도메인")

    # structures
    sub.add_parser("structures", help="사용 가능한 구조 패턴 목록")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return

    commands = {
        "add": cmd_add,
        "list": cmd_list,
        "ls": cmd_list,
        "search": cmd_search,
        "show": cmd_show,
        "tags": cmd_tags,
        "evolve": cmd_evolve,
        "spark": cmd_spark,
        "structures": cmd_structures,
    }

    commands[args.command](args)


if __name__ == "__main__":
    main()
